hl.monitor({
    output   = "",
    mode     = "preferred",
    position = "auto",
    scale    = "auto",
})

local terminal    = "kitty"
local fileManager = "nautilus"
local menu        = "wofi --show drun"
local screenshot  = "hyprshot -m region --raw | satty --filename -"

hl.on("hyprland.start", function () 
    hl.exec_cmd("waybar &")
    hl.exec_cmd("swaync &")
    hl.exec_cmd("hyprshade on crt &")
end)

hl.env("LIBVA_DRIVER_NAME", "iHD")
hl.env("WLR_RENDERER", "vulkan")
hl.env("XDG_SESSION_TYPE", "wayland")
hl.env("GBM_BACKEND", "intel-drm")
hl.env("WLR_NO_HARDWARE_CURSORS", "1")
hl.env("MOZ_ENABLE_WAYLAND", "1")
hl.env("OZONE_PLATFORM", "wayland")

hl.config({
    general = {
        gaps_in  = 4,
        gaps_out = 9,
        border_size = 3,
        col = {
            active_border   = { colors = {"rgba(FFB4A2EE)", "rgba(E5989BEE)", "rgba(B5838DEE)"}, angle = 45 },
            inactive_border = "rgba(6D6875AA)",
        },
        resize_on_border = true,
        allow_tearing = false,
        layout = "dwindle",
    },
    decoration = {
        rounding       = 15,
        rounding_power = 12,
        active_opacity   = 0.95,
        inactive_opacity = 0.85,
        shadow = {
            enabled      = true,
            range        = 12,
            render_power = 4,
            color        = 0x44000000,
        },
        blur = {
            enabled   = true,
            size      = 6,
            passes    = 3,
            vibrancy  = 0.85,
        },
    },
5    animations = {
        enabled = true,
    },
})

hl.curve("md3_standard",   { type = "bezier", points = { {0.2, 0.0}, {0, 1.0} } })
hl.curve("md3_decel",      { type = "bezier", points = { {0.05, 0.7}, {0.1, 1.0} } })
hl.curve("md3_accel",      { type = "bezier", points = { {0.3, 0.0}, {0.8, 0.15} } })
hl.curve("md3_overshoot",  { type = "bezier", points = { {0.05, 0.9}, {0.1, 1.1} } })

hl.animation({ leaf = "global",        enabled = true,  speed = 4,    bezier = "md3_standard" })
hl.animation({ leaf = "windows",       enabled = true,  speed = 5,    bezier = "md3_overshoot" })
hl.animation({ leaf = "windowsIn",     enabled = true,  speed = 5,    bezier = "md3_decel",      style = "popin 80%" })
hl.animation({ leaf = "windowsOut",    enabled = true,  speed = 4,    bezier = "md3_accel",      style = "popin 80%" })
hl.animation({ leaf = "fadeIn",        enabled = true,  speed = 3,    bezier = "md3_decel" })
hl.animation({ leaf = "fadeOut",       enabled = true,  speed = 3,    bezier = "md3_accel" })
hl.animation({ leaf = "workspaces",    enabled = true,  speed = 6,    bezier = "md3_decel",      style = "slide" })

hl.config({
    dwindle = {
        preserve_split = true,
    },
})

hl.config({
    misc = {
        force_default_wallpaper = 0,
        disable_hyprland_logo   = true,
    },
})

hl.config({
    input = {
        kb_layout  = "us,ara",
        kb_variant = "",
        kb_model   = "",
        kb_options = "grp:alt_shift_toggle",
        kb_rules   = "",
        follow_mouse = 1,
        sensitivity = 0,
        touchpad = {
            natural_scroll = true,
        },
    },
})

local mainMod = "SUPER"

hl.bind(mainMod .. " + SHIFT + M", hl.dsp.exit())
hl.bind(mainMod .. " + Q", hl.dsp.window.close())
hl.bind(mainMod .. " + RETURN", hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + SHIFT + SPACE", hl.dsp.exec_cmd("killall waybar; waybar &"))
hl.bind(mainMod .. " + SPACE", hl.dsp.exec_cmd(menu))
hl.bind(mainMod .. " + SHIFT + S", hl.dsp.exec_cmd(screenshot))
hl.bind(mainMod .. " + O", hl.dsp.window.pin())
hl.bind(mainMod .. " + SHIFT + O", hl.dsp.window.pin())
hl.bind(mainMod .. " + P", hl.dsp.window.pseudo())
hl.bind(mainMod .. " + L", hl.dsp.exec_cmd("hyprlock"))
hl.bind(mainMod .. " + SHIFT + F", hl.dsp.exec_cmd(fileManager))
hl.bind(mainMod .. " + F", hl.dsp.window.fullscreen("0"))
hl.bind(mainMod .. " + ALT + F", hl.dsp.window.fullscreen("1"))
hl.bind(mainMod .. " + w", hl.dsp.exec_cmd("wlogout"))

hl.bind(mainMod .. " + left",  hl.dsp.focus({ direction = "left" }))
hl.bind(mainMod .. " + right", hl.dsp.focus({ direction = "right" }))
hl.bind(mainMod .. " + up",    hl.dsp.focus({ direction = "up" }))
hl.bind(mainMod .. " + down",  hl.dsp.focus({ direction = "down" }))

for i = 1, 10 do
    local key = i % 10
    hl.bind(mainMod .. " + " .. key,             hl.dsp.focus({ workspace = i }))
    hl.bind(mainMod .. " + SHIFT + " .. key,     hl.dsp.window.move({ workspace = i }))
end

hl.window_rule({
    name  = "satty-floating-center",
    match = { class = "com.gabm.satty" },
    float = true,
    center = true,
})
